{
  "name": "@meridian-editor/app",
  "version": "0.1.0",
  "productName": "Meridian Room Editor",
  "private": true,
  "description": "Meridian room editor: edits room sources and compiles them to .roo for the original server or Server 104.",
  "author": "Meridian Shards",
  "license": "GPL-2.0-only",
  "type": "module",
  "main": "out/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "web": "vite",
    "build": "vite build && vite build --config vite.main.config.ts --mode main && vite build --config vite.main.config.ts --mode preload",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@meridian-editor/roo": "0.0.0",
    "@meridian-editor/roomc": "0.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.6.0",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "vite": "^8.3.3"
  }
}
